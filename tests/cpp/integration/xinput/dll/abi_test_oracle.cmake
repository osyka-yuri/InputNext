function(inputnext_validate_abi_manifest json expected_library out_error out_count)
    set(_error_message "")

    string(JSON _root_type ERROR_VARIABLE _json_error TYPE "${json}")
    if(NOT _json_error STREQUAL "NOTFOUND")
        set(_error_message "invalid JSON: ${_json_error}")
    elseif(NOT _root_type STREQUAL "OBJECT")
        set(_error_message "manifest root must be an object")
    endif()

    if(_error_message STREQUAL "")
        string(JSON _root_length ERROR_VARIABLE _json_error LENGTH "${json}")
        if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _root_length EQUAL 3)
            set(_error_message "manifest must contain exactly library, version, and exports")
        endif()
    endif()

    if(_error_message STREQUAL "")
        foreach(_key IN ITEMS library version exports)
            string(JSON _type ERROR_VARIABLE _json_error TYPE "${json}" "${_key}")
            if(NOT _json_error STREQUAL "NOTFOUND")
                set(_error_message "manifest is missing required field '${_key}'")
                break()
            endif()
            if(_key STREQUAL "library" OR _key STREQUAL "version")
                if(NOT _type STREQUAL "STRING")
                    set(_error_message "manifest field '${_key}' must be a string")
                    break()
                endif()
            elseif(NOT _type STREQUAL "ARRAY")
                set(_error_message "manifest field 'exports' must be an array")
                break()
            endif()
        endforeach()
    endif()

    if(_error_message STREQUAL "")
        string(JSON _library GET "${json}" library)
        string(JSON _version GET "${json}" version)
        if(_library STREQUAL "" OR NOT _library STREQUAL "${expected_library}")
            set(_error_message "manifest library must be '${expected_library}'")
        elseif(_version STREQUAL "")
            set(_error_message "manifest version must not be empty")
        endif()
    endif()

    if(_error_message STREQUAL "")
        string(JSON _export_count ERROR_VARIABLE _json_error LENGTH "${json}" exports)
        if(NOT _json_error STREQUAL "NOTFOUND" OR _export_count LESS 1)
            set(_error_message "manifest exports must not be empty")
        endif()
    endif()

    if(_error_message STREQUAL "")
        set(_seen_names)
        set(_seen_ordinals)
        math(EXPR _last_export "${_export_count} - 1")
        foreach(_index RANGE 0 ${_last_export})
            string(JSON _entry_type ERROR_VARIABLE _json_error TYPE "${json}" exports ${_index})
            if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _entry_type STREQUAL "OBJECT")
                set(_error_message "export ${_index} must be an object")
                break()
            endif()

            string(JSON _entry_length ERROR_VARIABLE _json_error LENGTH "${json}" exports ${_index})
            if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _entry_length EQUAL 3)
                set(_error_message "export ${_index} must contain exactly ordinal, name, and noname")
                break()
            endif()

            string(JSON _ordinal_type ERROR_VARIABLE _json_error TYPE "${json}" exports ${_index} ordinal)
            if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _ordinal_type STREQUAL "NUMBER")
                set(_error_message "export ${_index} ordinal must be an integer number")
                break()
            endif()
            string(JSON _ordinal GET "${json}" exports ${_index} ordinal)
            string(LENGTH "${_ordinal}" _ordinal_length)
            if(NOT _ordinal MATCHES "^[1-9][0-9]*$" OR _ordinal_length GREATER 5)
                set(_error_message "export ${_index} ordinal must be in the range 1..65535")
                break()
            endif()
            if(_ordinal GREATER 65535)
                set(_error_message "export ${_index} ordinal must be in the range 1..65535")
                break()
            endif()
            if(_ordinal IN_LIST _seen_ordinals)
                set(_error_message "export ordinal ${_ordinal} is duplicated")
                break()
            endif()
            list(APPEND _seen_ordinals "${_ordinal}")

            string(JSON _name_type ERROR_VARIABLE _json_error TYPE "${json}" exports ${_index} name)
            if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _name_type STREQUAL "STRING")
                set(_error_message "export ${_index} name must be a string")
                break()
            endif()
            string(JSON _name GET "${json}" exports ${_index} name)
            if(NOT _name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
                set(_error_message "export ${_index} name must be a nonempty C symbol")
                break()
            endif()
            if(_name IN_LIST _seen_names)
                set(_error_message "export name '${_name}' is duplicated")
                break()
            endif()
            list(APPEND _seen_names "${_name}")

            string(JSON _noname_type ERROR_VARIABLE _json_error TYPE "${json}" exports ${_index} noname)
            if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _noname_type STREQUAL "BOOLEAN")
                set(_error_message "export ${_index} noname must be a boolean")
                break()
            endif()
        endforeach()
    endif()

    set(${out_error} "${_error_message}" PARENT_SCOPE)
    if(_error_message STREQUAL "")
        set(${out_count} "${_export_count}" PARENT_SCOPE)
    else()
        set(${out_count} 0 PARENT_SCOPE)
    endif()
endfunction()

function(inputnext_append_abi_manifest header_variable manifest_path expected_library array_name)
    file(READ "${manifest_path}" _json)
    inputnext_validate_abi_manifest("${_json}" "${expected_library}" _error _count)
    if(NOT _error STREQUAL "")
        message(FATAL_ERROR "Invalid ABI manifest '${manifest_path}': ${_error}")
    endif()

    set(_block "inline constexpr std::array<expected_export, ${_count}U> ${array_name}{{\n")
    math(EXPR _last_export "${_count} - 1")
    foreach(_index RANGE 0 ${_last_export})
        string(JSON _ordinal GET "${_json}" exports ${_index} ordinal)
        string(JSON _name GET "${_json}" exports ${_index} name)
        string(JSON _noname GET "${_json}" exports ${_index} noname)
        if(_noname)
            set(_cpp_noname true)
        else()
            set(_cpp_noname false)
        endif()
        string(APPEND _block "    {.ordinal = ${_ordinal}U, .name = \"${_name}\", .noname = ${_cpp_noname}},\n")
    endforeach()
    string(APPEND _block "}};\n\n")

    set(_combined "${${header_variable}}${_block}")
    set(${header_variable} "${_combined}" PARENT_SCOPE)
endfunction()

function(inputnext_generate_abi_expected_header output_path)
    set(_header "#pragma once\n\n#include \"pe_exports.hpp\"\n#include <array>\n\nnamespace inputnext::xinput_dll_tests {\n\n")
    inputnext_append_abi_manifest(_header "${PROJECT_SOURCE_DIR}/abi/xinput1_3.json"
        "xinput1_3.dll" xinput13_exports)
    inputnext_append_abi_manifest(_header "${PROJECT_SOURCE_DIR}/abi/xinput1_4.json"
        "xinput1_4.dll" xinput14_exports)
    inputnext_append_abi_manifest(_header "${PROJECT_SOURCE_DIR}/abi/xinput9_1_0.json"
        "xinput9_1_0.dll" xinput910_exports)
    inputnext_append_abi_manifest(_header "${PROJECT_SOURCE_DIR}/abi/inputnext_runtime.json"
        "inputnext_runtime.dll" runtime_exports)
    string(APPEND _header "} // namespace inputnext::xinput_dll_tests\n")
    file(WRITE "${output_path}" "${_header}")
endfunction()
