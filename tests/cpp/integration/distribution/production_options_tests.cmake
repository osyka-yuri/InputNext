cmake_minimum_required(VERSION 4.4.4)

if(NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "TEST_ROOT must identify this build's test directory.")
endif()

if(DEFINED CASE)
    set(INPUTNEXT_PRODUCTION ON CACHE BOOL "")
    set(CMAKE_BUILD_TYPE Release)
    set(CMAKE_CXX_COMPILER_ID MSVC)
    set(CMAKE_C_COMPILER_ID MSVC)
    set(INPUTNEXT_NATIVE_PROFILE Default)
    if(CASE STREQUAL "invalid-mode")
        set(INPUTNEXT_PGO_MODE Invalid CACHE STRING "")
    elseif(CASE STREQUAL "pgo-without-production")
        set(INPUTNEXT_PRODUCTION OFF CACHE BOOL "" FORCE)
        set(INPUTNEXT_PGO_MODE Instrument CACHE STRING "")
    elseif(CASE STREQUAL "debug")
        set(CMAKE_BUILD_TYPE Debug)
    elseif(CASE STREQUAL "sanitizer")
        set(INPUTNEXT_NATIVE_PROFILE Address)
    elseif(CASE STREQUAL "clang")
        set(CMAKE_CXX_COMPILER_ID Clang)
    elseif(CASE STREQUAL "multi-config")
        set(CMAKE_CONFIGURATION_TYPES "Debug;Release")
    elseif(CASE STREQUAL "profile-path")
        set(INPUTNEXT_PGO_MODE Instrument CACHE STRING "")
        set(INPUTNEXT_PGO_DIRECTORY "relative,profile" CACHE PATH "")
    elseif(CASE STREQUAL "incomplete-profiles")
        set(INPUTNEXT_PGO_MODE Optimize CACHE STRING "")
        set(INPUTNEXT_PGO_DIRECTORY "${TEST_ROOT}/incomplete-pgo" CACHE PATH "")
        file(MAKE_DIRECTORY "${INPUTNEXT_PGO_DIRECTORY}/trained")
        file(REMOVE "${INPUTNEXT_PGO_DIRECTORY}/trained/ready")
        file(WRITE "${INPUTNEXT_PGO_DIRECTORY}/trained/inputnext_runtime.pgd" "previous profile")
    endif()
    include("${PROJECT_ROOT}/cmake/ProductionOptions.cmake")
    inputnext_prepare_production_configuration()
    return()
endif()

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run)
set(TEST_ROOT "${TEST_ROOT}/${run}")
foreach(case IN ITEMS valid invalid-mode pgo-without-production debug sanitizer clang multi-config profile-path incomplete-profiles)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROJECT_ROOT=${PROJECT_ROOT}"
        "-DTEST_ROOT=${TEST_ROOT}" "-DCASE=${case}"
        -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(case STREQUAL "valid")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid production settings failed: ${output}${errors}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Invalid production settings passed: ${case}")
    endif()
endforeach()
