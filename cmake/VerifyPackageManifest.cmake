cmake_minimum_required(VERSION 4.4.4)

if(NOT IS_DIRECTORY "${PACKAGE_ROOT}")
    message(FATAL_ERROR "PACKAGE_ROOT must identify an extracted package.")
endif()
file(READ "${PACKAGE_ROOT}/manifest.json" manifest)
string(JSON schema GET "${manifest}" schema)
if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported package manifest schema.")
endif()
string(JSON count LENGTH "${manifest}" files)
if(count LESS 1)
    message(FATAL_ERROR "Package manifest has no files.")
endif()
math(EXPR last "${count} - 1")
set(expected manifest.json)
foreach(index RANGE 0 ${last})
    string(JSON path MEMBER "${manifest}" files ${index})
    if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.?(/|$)|[\\\\:;]" OR path STREQUAL "manifest.json")
        message(FATAL_ERROR "Invalid package path: ${path}")
    endif()
    string(JSON expected_hash GET "${manifest}" files "${path}")
    string(LENGTH "${expected_hash}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT expected_hash MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid SHA-256 for ${path}.")
    endif()
    file(SHA256 "${PACKAGE_ROOT}/${path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Package hash mismatch: ${path}")
    endif()
    list(APPEND expected "${path}")
endforeach()
file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${PACKAGE_ROOT}" "${PACKAGE_ROOT}/*")
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Package contains missing or unlisted files.")
endif()
file(READ "${PACKAGE_ROOT}/build-info.json" info)
string(JSON architecture GET "${info}" architecture)
string(JSON configuration GET "${info}" configuration)
string(JSON optimization GET "${info}" optimization)
string(JSON pgo GET "${info}" pgo)
if(NOT architecture STREQUAL PACKAGE_ARCHITECTURE OR NOT architecture MATCHES "^(x64|x86)$")
    message(FATAL_ERROR "Package architecture does not match ${PACKAGE_ARCHITECTURE}.")
endif()
if(NOT configuration STREQUAL "Release" OR NOT optimization STREQUAL "LTCG" OR NOT pgo MATCHES "^(Off|Optimize)$")
    message(FATAL_ERROR "Package is not an optimized production build.")
endif()
if(PACKAGE_SYMBOLS)
    set(required build-info.json manifest.json
        symbols/inputnext_runtime.pdb symbols/xinput1_3.pdb
        symbols/xinput1_4.pdb symbols/xinput9_1_0.pdb)
    list(SORT required)
    if(NOT actual STREQUAL required)
        message(FATAL_ERROR "Symbols package must contain exactly the four PDBs and metadata.")
    endif()
else()
    set(required
        bin/inputnext_runtime.dll bin/xinput1_3.dll bin/xinput1_4.dll bin/xinput9_1_0.dll
        bin/GameInputRedist.dll bin/GameInputRawInputProxy.exe
        LICENSE README.md THIRD_PARTY_NOTICES.md build-info.json manifest.json
        sdk/input_next_core.h sdk/input_next_effects.h examples/inputnext.toml examples/CMakeLists.txt
        licenses/third-party/Microsoft-GameInput.txt licenses/third-party/MIT-GameInput.txt
        licenses/third-party/NOTICE-GameInput.txt licenses/third-party/MIT-tomlplusplus.txt
        examples/core/core_example.cpp examples/core/core_reader.c examples/core/core_reader.h
        examples/effects/effects_example.cpp examples/effects/effects_demo.c examples/effects/effects_demo.h)
    foreach(path IN LISTS required)
        if(NOT path IN_LIST actual)
            message(FATAL_ERROR "Missing required distribution file: ${path}")
        endif()
    endforeach()
    foreach(path IN LISTS actual)
        if(NOT path IN_LIST required AND NOT path MATCHES "^docs/[a-z0-9-]+\\.md$")
            message(FATAL_ERROR "Unexpected distribution file: ${path}")
        endif()
    endforeach()
endif()
message(STATUS "Package manifest verified: ${PACKAGE_ARCHITECTURE}, ${count} files")
