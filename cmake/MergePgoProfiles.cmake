cmake_minimum_required(VERSION 4.4.4)

file(MAKE_DIRECTORY "${PROFILE_DIRECTORY}/trained")
file(REMOVE "${PROFILE_DIRECTORY}/trained/ready")
file(READ "${PROFILE_DIRECTORY}/campaign" campaign)
file(READ "${PROFILE_DIRECTORY}/instrumented" instrumented)
if(NOT campaign MATCHES "^[0-9a-f]+$" OR NOT campaign STREQUAL instrumented)
    message(FATAL_ERROR "Merge requires a completed instrumented link for the current campaign.")
endif()
file(GLOB counters LIST_DIRECTORIES FALSE "${COUNTER_DIRECTORY}/inputnext_runtime!*.pgc")
if(NOT counters)
    message(FATAL_ERROR "No runtime training counters. Exit the training process before merging.")
endif()
set(profile "${PROFILE_DIRECTORY}/trained/inputnext_runtime.pgd")
file(COPY_FILE "${PROFILE_DIRECTORY}/inputnext_runtime.pgd" "${profile}")
execute_process(COMMAND "${PGO_MANAGER}" /clear "${profile}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${PGO_MANAGER}" /merge ${counters} "${profile}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${PROFILE_DIRECTORY}/inputnext_runtime.pgd" raw_hash)
file(SHA256 "${profile}" trained_hash)
file(WRITE "${PROFILE_DIRECTORY}/trained/ready"
    "{\"campaign\":\"${campaign}\",\"raw_sha256\":\"${raw_hash}\",\"trained_sha256\":\"${trained_hash}\"}\n")
