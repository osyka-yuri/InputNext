cmake_minimum_required(VERSION 4.4.4)

file(REMOVE "${PROFILE_DIRECTORY}/trained/ready" "${PROFILE_DIRECTORY}/instrumented")
file(GLOB counters LIST_DIRECTORIES FALSE "${COUNTER_DIRECTORY}/inputnext_runtime!*.pgc")
if(counters)
    string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef archive_id)
    set(archive "${PROFILE_DIRECTORY}/retired-counters/${archive_id}")
    file(MAKE_DIRECTORY "${archive}")
    foreach(counter IN LISTS counters)
        get_filename_component(name "${counter}" NAME)
        file(COPY_FILE "${counter}" "${archive}/${name}")
        file(REMOVE "${counter}")
        if(EXISTS "${counter}")
            message(FATAL_ERROR "Cannot isolate the previous instrumentation counters: ${counter}")
        endif()
    endforeach()
endif()
