set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
list(REMOVE_ITEM files manifest.json)
list(SORT files)
set(manifest "{\"schema\":1,\"files\":{}}")
foreach(path IN LISTS files)
    file(SHA256 "${root}/${path}" hash)
    string(JSON manifest SET "${manifest}" files "${path}" "\"${hash}\"")
endforeach()
file(WRITE "${root}/manifest.json" "${manifest}\n")
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${root}/manifest.json")
