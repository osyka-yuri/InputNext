cmake_minimum_required(VERSION 4.4.4)

foreach(path IN ITEMS campaign instrumented inputnext_runtime.pgd trained/inputnext_runtime.pgd trained/ready)
    if(NOT EXISTS "${PROFILE_DIRECTORY}/${path}")
        message(FATAL_ERROR "Optimize requires completed training for the current campaign: missing ${path}.")
    endif()
endforeach()
file(READ "${PROFILE_DIRECTORY}/campaign" campaign)
file(READ "${PROFILE_DIRECTORY}/instrumented" instrumented)
file(READ "${PROFILE_DIRECTORY}/trained/ready" ready)
string(JSON trained_campaign GET "${ready}" campaign)
if(NOT campaign MATCHES "^[0-9a-f]+$" OR NOT campaign STREQUAL instrumented OR NOT campaign STREQUAL trained_campaign)
    message(FATAL_ERROR "The trained profile does not belong to the current instrumented campaign.")
endif()
foreach(kind IN ITEMS raw trained)
    if(kind STREQUAL "raw")
        set(path "${PROFILE_DIRECTORY}/inputnext_runtime.pgd")
    else()
        set(path "${PROFILE_DIRECTORY}/trained/inputnext_runtime.pgd")
    endif()
    string(JSON expected_hash GET "${ready}" "${kind}_sha256")
    file(SHA256 "${path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "The ${kind} profile changed after the current campaign was merged.")
    endif()
endforeach()
