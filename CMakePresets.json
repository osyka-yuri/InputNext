{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 4
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "VSLANG": "1033"
      },
      "errors": {
        "author": true
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "INPUTNEXT_NATIVE_PROFILE": "Default",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "INPUTNEXT_TARGET_ARCHITECTURE": "x64",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "windows-x64-production",
      "displayName": "Windows x64 Production",
      "inherits": "windows-x64-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "INPUTNEXT_PRODUCTION": "ON"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "INPUTNEXT_TARGET_ARCHITECTURE": "x86",
        "INPUTNEXT_BUILD_GAMEINPUT": "ON",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "ON"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "windows-x86-release",
      "displayName": "Windows x86 Release",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "windows-x86-production",
      "displayName": "Windows x86 Production",
      "inherits": "windows-x86-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "INPUTNEXT_PRODUCTION": "ON"
      }
    },
    {
      "name": "windows-x64-analyze",
      "displayName": "Windows x64 MSVC Analysis",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INPUTNEXT_NATIVE_PROFILE": "Analyze",
        "INPUTNEXT_BUILD_GAMEINPUT": "ON",
        "INPUTNEXT_BUILD_STRESS_TESTS": "OFF"
      }
    },
    {
      "name": "windows-x64-analyze-production",
      "displayName": "Windows x64 MSVC Analysis, Production",
      "inherits": "windows-x64-analyze",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "INPUTNEXT_BUILD_DIAGNOSTICS": "OFF"
      }
    },
    {
      "name": "windows-x64-asan",
      "displayName": "Windows x64 AddressSanitizer",
      "inherits": "windows-x64",
      "cacheVariables": {
        "INPUTNEXT_NATIVE_PROFILE": "Address",
        "INPUTNEXT_BUILD_GAMEINPUT": "ON",
        "INPUTNEXT_BUILD_STRESS_TESTS": "OFF"
      }
    },
    {
      "name": "windows-x86-asan",
      "displayName": "Windows x86 AddressSanitizer",
      "inherits": "windows-x86",
      "cacheVariables": {
        "INPUTNEXT_NATIVE_PROFILE": "Address",
        "INPUTNEXT_BUILD_GAMEINPUT": "ON",
        "INPUTNEXT_BUILD_STRESS_TESTS": "OFF"
      }
    },
    {
      "name": "windows-x64-ubsan",
      "displayName": "Windows x64 UndefinedBehaviorSanitizer",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "INPUTNEXT_NATIVE_PROFILE": "Undefined",
        "INPUTNEXT_BUILD_GAMEINPUT": "ON",
        "INPUTNEXT_BUILD_STRESS_TESTS": "OFF"
      }
    },
    {
      "name": "windows-x64-pgo",
      "displayName": "Windows x64 PGO Training",
      "inherits": "windows-x64-production",
      "cacheVariables": {
        "INPUTNEXT_PGO_MODE": "Instrument"
      }
    },
    {
      "name": "windows-x86-pgo",
      "displayName": "Windows x86 PGO Training",
      "inherits": "windows-x86-production",
      "cacheVariables": {
        "INPUTNEXT_PGO_MODE": "Instrument"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-production",
      "configurePreset": "windows-x64-production",
      "targets": [
        "inputnext_distribution"
      ]
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86-release"
    },
    {
      "name": "windows-x86-production",
      "configurePreset": "windows-x86-production",
      "targets": [
        "inputnext_distribution"
      ]
    },
    {
      "name": "windows-x64-analyze",
      "configurePreset": "windows-x64-analyze"
    },
    {
      "name": "windows-x64-analyze-production",
      "configurePreset": "windows-x64-analyze-production"
    },
    {
      "name": "windows-x64-asan",
      "configurePreset": "windows-x64-asan"
    },
    {
      "name": "windows-x86-asan",
      "configurePreset": "windows-x86-asan"
    },
    {
      "name": "windows-x64-ubsan",
      "configurePreset": "windows-x64-ubsan"
    },
    {
      "name": "windows-x64-pgo",
      "configurePreset": "windows-x64-pgo",
      "targets": [
        "inputnext_xinput_bundle"
      ]
    },
    {
      "name": "windows-x86-pgo",
      "configurePreset": "windows-x86-pgo",
      "targets": [
        "inputnext_xinput_bundle"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "windows-x86-release",
      "inherits": "windows-x86",
      "configurePreset": "windows-x86-release"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-analyze",
      "configurePreset": "windows-x64-analyze",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-asan",
      "configurePreset": "windows-x64-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-asan",
      "configurePreset": "windows-x86-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-ubsan",
      "configurePreset": "windows-x64-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
